#!/usr/bin/env python3
"""Run tdb's tooling tests and application checks; bin/check --full calls this after the foundation checks."""
import os
from pathlib import Path
import re
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
env = dict(os.environ, GOWORK="off")
try:
    # Tooling tests run first, with the caller's environment.
    subprocess.run([sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests", "-p", "test_app_checks.py", "-v"],
                   cwd=root, check=True)
    version = subprocess.check_output(["go", "version"], cwd=root, env=env, text=True).strip()
    found = re.search(r"\bgo(\d+)\.(\d+)", version)
    if not found or tuple(map(int, found.groups())) < (1, 27):
        raise RuntimeError("Go 1.27 or newer is required; detected " + version + ". Select the latest stable Go toolchain.")
    node_version = subprocess.check_output(["node", "--version"], cwd=root, env=env, text=True).strip()
    found = re.fullmatch(r"v(\d+)\.\d+\.\d+", node_version)
    if not found or int(found.group(1)) < 24:
        raise RuntimeError("Node.js 24 or newer is required for application checks; detected " + node_version
                           + ". Select the latest LTS (lts/*) with your Node.js version manager.")
    sources = sorted(root.glob("*.go")) + sorted((root / "internal").rglob("*.go"))
    unformatted = subprocess.check_output(["gofmt", "-l", *map(str, sources)], cwd=root, env=env, text=True)
    if unformatted.strip():
        raise RuntimeError("Run gofmt on:\n" + unformatted)
    browser_tests = sorted((root / "tests").glob("*.test.mjs"))
    if not browser_tests:
        raise RuntimeError("No browser event tests found in tests/*.test.mjs.")
    for command in (["node", "--test", *map(str, browser_tests)],
                    ["go", "test", "-race", ".", "./internal/..."],
                    ["go", "vet", ".", "./internal/..."],
                    ["go", "build", "-o", "dist/tdb", "."]):
        subprocess.run(command, cwd=root, env=env, check=True)
except (OSError, RuntimeError, subprocess.SubprocessError) as error:
    print(error, file=sys.stderr)
    sys.exit(1)
